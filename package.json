{
  "name": "score-record-app",
  "version": "3.0.0",
  "description": "Score Record native iPad and iPhone app",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "start": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "prebuild": "node scripts/gen-announcements.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "ios:sync": "npm run build -- --mode ios && cap sync ios",
    "ios:open": "cap open ios",
    "check": "node scripts/check-bindings.mjs && node scripts/gen-announcements.mjs --check && node scripts/test-paper-group.mjs && node scripts/test-duration.mjs && node scripts/test-sorting.mjs && node scripts/test-store.mjs && node scripts/test-demo-sync.mjs && npm run check:backup-import && node scripts/check-dialogs.mjs && node scripts/check-export.mjs && node scripts/check-announcements.mjs && node scripts/check-pwa.mjs && node scripts/check-theme.mjs && node scripts/check-interactions.mjs && node scripts/audit-interaction.mjs && node scripts/audit-a11y.mjs",
    "check:ui": "node scripts/verify-ui.mjs",
    "check:buttons": "node scripts/audit-buttons.mjs",
    "check:a11y": "node scripts/audit-a11y.mjs",
    "check:store": "node scripts/test-store.mjs",
    "check:backup-import": "node scripts/test-import.mjs && node scripts/check-backup-import.mjs",
    "check:demo-sync": "node scripts/test-demo-sync.mjs",
    "check:announcements": "node scripts/check-announcements.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "check:interactions": "node scripts/check-interactions.mjs",
    "gen:announcements": "node scripts/gen-announcements.mjs",
    "gen:splash": "node scripts/gen-splash.mjs",
    "check:duration": "node scripts/test-duration.mjs",
    "check:dashboard": "node scripts/check-dashboard.mjs",
    "check:record-entry": "node scripts/check-record-entry.mjs",
    "check:record-performance": "node scripts/check-record-performance.mjs",
    "check:sorting": "node scripts/test-sorting.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
    "check:interaction": "node scripts/audit-interaction.mjs",
    "find:dead-css": "node scripts/find-dead-css.mjs",
    "diff:shots": "node scripts/diff-shots.mjs",
    "crop:diff": "node scripts/crop-diff.mjs",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/splash-screen": "8.0.2",
    "@lucide/vue": "^1.17.0",
    "@supabase/supabase-js": "^2.107.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "dexie": "^4.4.3",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "pinia": "^3.0.4",
    "vite": "^8.0.16",
    "vue": "^3.5.35",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
